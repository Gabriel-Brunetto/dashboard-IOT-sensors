// crie uma copia deste arquivo, neste mesmo diretorio, e renomeie ele como "secrets.h" para declarar as credenciais de rede wi-fi, e insira os dados necessarios nas constantes abaixo
// o arquivo "secrets.h" é ignorado pelo git-ignore, portanto, sera ignorado nos registros do repositorio
//lembre-se de fazer o mesmo nos diretorios de codigo do sensor e do fimware.
#pragma once
#define ROUTER_SSID "sua-rede"
#define ROUTER_PASS "sua-senha"

// rede que o gateway cria para os sensores, e os sensores usam os mesmos valores nos seus secrets.h
// a senha precisa ter no minimo 8 caracteres
#define AP_SSID "gateway-estacoes"
#define AP_PASS "troque-esta-senha"

// Pontos de partida da descoberta: o D1 pergunta a QUALQUER um quem e o lider
// (IP do computador que roda os containers + portas publicadas). Depois disso so usa o lider.
const char* SEEDS[] = { "192.168.1.2:8081", "192.168.1.2:8082", "192.168.1.2:8083" };
