#decalre o IP do host a rodar o servidor na constante abaixo, copiando este mesmo arquivo neste mesmo repositório e renomeando ele de ".env.example" para somente ".env" e substituindo "IPdoHOST" pelo IP real do host
# O arquivo ".env" esta inserido no git-ingore, portanto, sera ignorado nos registros do repositorio

HOST_IP=IPdoHOST
